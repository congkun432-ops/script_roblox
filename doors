local function Label(text, size, color, font, y, h)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -28, 0, h)
    l.Position = UDim2.new(0, 14, 0, y)
    l.BackgroundTransparency = 1
    l.Font = font
    l.Text = text
    l.TextSize = size
    l.TextColor3 = color
    l.TextWrapped = true
    l.ZIndex = 11
    l.Parent = Card
    return l
end

