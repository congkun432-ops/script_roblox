-- Mưa icon
local alive = true
local function Drop()
    if #Rain:GetChildren() >= CONFIG.MaxDrops then return end
    local size = math.random(26, 52)
    local x = math.random()
    local useImage = math.random() < CONFIG.ImageChance

    local obj
    if useImage then
        obj = Instance.new("ImageLabel")
        obj.Image = CONFIG.ImageId
        obj.ScaleType = Enum.ScaleType.Crop
        Instance.new("UICorner", obj).CornerRadius = UDim.new(1, 0)
    else
        obj = Instance.new("TextLabel")
        obj.Text = CONFIG.Emojis[math.random(1, #CONFIG.Emojis)]
        obj.TextSize = size
        obj.Font = Enum.Font.GothamBold
        obj.TextColor3 = Color3.new(1, 1, 1)
    end
    obj.AnchorPoint = Vector2.new(0.5, 0.5)
    obj.Size = UDim2.new(0, size, 0, size)
    obj.Position = UDim2.new(x, 0, 0, -size)
    obj.BackgroundTransparency = 1
    obj.BorderSizePixel = 0
    obj.Rotation = math.random(-25, 25)
    obj.ZIndex = 3
    obj.Parent = Rain

    local dur = 3 + math.random() * 3
    local t = TweenService:Create(obj, TweenInfo.new(dur, Enum.EasingStyle.Linear), {
        Position = UDim2.new(math.clamp(x + (math.random() - 0.5) * 0.15, 0, 1), 0, 1, size),
        Rotation = obj.Rotation + math.random(-180, 180)
    })
    t:Play()
    t.Completed:Connect(function() obj:Destroy() end)
end

task.spawn(function()
    while alive and Gui.Parent do
        Drop()
        task.wait(CONFIG.SpawnDelay)
    end
end)

Close.MouseButton1Click:Connect(function()
    alive = false
    TweenService:Create(Card, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0)
    }):Play()
    TweenService:Create(Dim, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
    task.delay(0.3, function() Gui:Destroy() end)
end)
